{
  "id": "dev.micyou.example.noisegate",
  "name": "Example Noise Gate",
  "version": "1.0.0",
  "author": "MicYou",
  "description": "示例降噪引擎：RMS 噪声门 DSP 节点，低于阈值的背景噪音自动衰减（config: threshold/depth/attackMs/releaseMs）",
  "runtime": "native",
  "entry": "libmicyou_example_native_noisegate.so",
  "platforms": ["linux", "windows", "macos"],
  "apiVersion": 1,
  "capabilities": ["dsp.node", "config.read"],
  "kind": "dsp",
  "dsp": {
    "insertAfter": "AEC",
    "realtimeSafe": true
  },
  "config": {
    "threshold": -40.0,
    "depth": 20.0,
    "attackMs": 5.0,
    "releaseMs": 150.0
  }
}
